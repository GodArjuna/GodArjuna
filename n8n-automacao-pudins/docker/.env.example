# ============================================
# CONFIGURAÇÃO N8N - AUTOMAÇÃO DE PUDINS
# ============================================
# 
# INSTRUÇÕES:
# 1. Copie este arquivo para .env (sem o .example)
# 2. Preencha os valores abaixo
# 3. NÃO compartilhe este arquivo (contém senhas!)
#
# ============================================

# --------------------------------------------
# CONFIGURAÇÃO BÁSICA (OBRIGATÓRIO)
# --------------------------------------------

# Porta onde n8n vai rodar (padrão: 5678)
N8N_PORT=5678

# Usuário de login do n8n
N8N_USER=admin

# Senha de login do n8n (MUDE ESTA SENHA!)
# Regra: mínimo 8 caracteres, com letras e números
N8N_PASSWORD=MudeEstaSenha123!

# --------------------------------------------
# WEBHOOK E ACESSO (IMPORTANTE)
# --------------------------------------------

# URL base para webhooks
# OPÇÕES:
# - Localhost: http://localhost:5678/
# - IP Local: http://192.168.1.100:5678/ (substitua pelo seu IP)
# - Domínio: http://seu-dominio.com/ (se tiver)
#
# Para descobrir seu IP local:
# Windows: ipconfig
# Linux/Mac: ip a ou ifconfig
WEBHOOK_URL=http://localhost:5678/

# Host onde n8n escuta (não mude a menos que saiba o que está fazendo)
N8N_HOST=0.0.0.0

# Protocolo (http ou https)
N8N_PROTOCOL=http

# --------------------------------------------
# TIMEZONE
# --------------------------------------------

# Timezone do Brasil (não precisa mudar)
TIMEZONE=America/Sao_Paulo

# --------------------------------------------
# RETENÇÃO DE DADOS
# --------------------------------------------

# Por quantas horas manter histórico de execuções
# 168 horas = 7 dias (recomendado)
# 72 horas = 3 dias (economiza espaço)
# 336 horas = 14 dias (mais histórico)
EXECUTIONS_MAX_AGE=168

# --------------------------------------------
# LOGS E DEBUG
# --------------------------------------------

# Nível de log (error, warn, info, verbose, debug)
# Recomendado: info (use debug só se tiver problemas)
LOG_LEVEL=info

# --------------------------------------------
# LIMITES DE RECURSOS
# --------------------------------------------

# Limite de CPU (número de cores)
# Exemplos: 1, 2, 4
# Recomendado: 2
CPU_LIMIT=2

# Memória máxima (com unidade: M para MB, G para GB)
# Exemplos: 1G, 2G, 4G
# Recomendado: 2G
MEMORY_LIMIT=2G

# CPU reservada (mínimo garantido)
CPU_RESERVE=0.5

# Memória reservada (mínimo garantido)
MEMORY_RESERVE=512M

# ============================================
# INFORMAÇÕES DO SEU SISTEMA (PARA REFERÊNCIA)
# ============================================
# Anote aqui informações importantes:

# IP do notebook: ___________________
# Sistema operacional: ___________________
# Versão do Docker: ___________________
# Data de instalação: ___________________

# ============================================
# NOTAS IMPORTANTES
# ============================================
#
# 1. Após preencher, renomeie para .env (sem .example)
# 2. Execute: docker-compose up -d
# 3. Acesse: http://localhost:5678 (ou seu IP)
# 4. Login: use N8N_USER e N8N_PASSWORD acima
#
# Para parar: docker-compose down
# Para logs: docker-compose logs -f
# Para reiniciar: docker-compose restart
#
# ============================================

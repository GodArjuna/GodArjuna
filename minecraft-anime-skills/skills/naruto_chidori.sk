# Chidori - Naruto
# Generated by AnimeSkills AI Generator
# Type: attack
# Description: Relâmpago cortante que perfura tudo

command /chidori:
    permission: animeskills.naruto.chidori
    cooldown: 10 seconds
    cooldown message: §c[AnimeSkills] Aguarde %remaining time% para usar Chidori novamente!
    trigger:
        # Check if player has enough mana
        if {player_mana_%player%} >= 50:
            # Lightning charge effect
            send "§e[Chidori] §fConcentrando relâmpago..." to player
            
            # Charging particles
            loop 15 times:
                play "FIREWORKS_SPARK" at player
                play "SPELL_INSTANT" at player
                play sound "FIZZ" to player with pitch 2
                wait 2 ticks
            
            # Execute dash and attack
            send "§e[Chidori] §f§lCHIDORI!" to player
            play sound "AMBIENCE_THUNDER" to all players in radius 30 of player
            
            # Dash forward
            set velocity of player to direction of player
            multiply velocity of player by 3
            set y-velocity of player to 0.3
            
            # Lightning trail
            loop 20 times:
                play "FIREWORKS_SPARK" at player
                play "CRIT_MAGIC" at player
                wait 1 tick
            
            wait 10 ticks
            
            # Check for hit
            set {_target} to target entity of player within 5 blocks
            if {_target} is set:
                # Critical hit with lightning
                damage {_target} by 15 hearts
                
                # Lightning strike effect (visual only)
                play "EXPLOSION_HUGE" at {_target}
                play "FIREWORKS_SPARK" at {_target}
                
                loop 30 times:
                    play "FIREWORKS_SPARK" at {_target}
                    play "CRIT" at {_target}
                
                # Paralyze effect
                apply slowness 5 to {_target} for 3 seconds
                apply blindness 1 to {_target} for 2 seconds
                
                # Sounds
                play sound "EXPLODE" to all players in radius 20 of {_target}
                play sound "AMBIENCE_THUNDER" to {_target}
                
                send "§e[Chidori] §fAtaque crítico! Alvo paralisado!" to player
                
                # Check combo
                if check_combo(player, "chidori"):
                    # Combo bonus - extra lightning damage
                    damage {_target} by 7 hearts
                    send "§6§l⚡ COMBO CHIDORI! §fDano extra!" to player
            else:
                # AOE lightning burst
                loop all entities in radius 3 of player:
                    if loop-entity is not player:
                        damage loop-entity by 10 hearts
                        apply slowness 3 to loop-entity for 2 seconds
                        play "FIREWORKS_SPARK" at loop-entity
            
            # Consume mana
            subtract 50 from {player_mana_%player%}
            
            # Add XP
            add_skill_xp(player, 15)
            
            # Store last skill
            set {last_skill_%player%} to "chidori"
            set {last_skill_time_%player%} to now
            
        else:
            send "§c[AnimeSkills] Chakra insuficiente! Necessário: 50" to player
            play sound "ITEM_BREAK" to player

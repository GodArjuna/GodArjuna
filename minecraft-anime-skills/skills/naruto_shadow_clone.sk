# Shadow Clone - Naruto
# Generated by AnimeSkills AI Generator
# Type: buff
# Description: Cria clones de sombra para auxiliar na batalha

command /shadowclone:
    permission: animeskills.naruto.shadow-clone
    cooldown: 30 seconds
    cooldown message: §c[AnimeSkills] Aguarde %remaining time% para usar Shadow Clone novamente!
    trigger:
        # Check if player has enough mana
        if {player_mana_%player%} >= 60:
            send "§6[Shadow Clone] §fKage Bunshin no Jutsu!" to player
            
            # Smoke effect
            loop 20 times:
                play "EXPLOSION_LARGE" at player
                play "CLOUD" at player
            
            play sound "EXPLODE" to all players in radius 15 of player
            
            # Create "clones" effect by spawning armor stands
            set {_loc} to location of player
            
            # Spawn 3 clones around player
            loop 3 times:
                # Calculate position around player
                set {_angle} to loop-number * 120
                set {_x} to cos({_angle}) * 2
                set {_z} to sin({_angle}) * 2
                
                set {_clone_loc} to location(x-coordinate of {_loc} + {_x}, y-coordinate of {_loc}, z-coordinate of {_loc} + {_z}, world of {_loc})
                
                # Visual effect at clone location
                play "EXPLOSION_LARGE" at {_clone_loc}
                play "CLOUD" at {_clone_loc}
            
            # Grant buff effects (representing clones helping)
            apply strength 2 to player for 20 seconds
            apply speed 2 to player for 20 seconds
            apply resistance 1 to player for 20 seconds
            apply regeneration 1 to player for 20 seconds
            
            send "§a[Shadow Clone] §fClones criados! Efeitos ativados por 20 segundos!" to player
            send "§7Força II, Velocidade II, Resistência I, Regeneração I" to player
            
            # Periodic clone effects
            loop 20 times:
                wait 1 second
                
                # Random clone attacks on nearby enemies
                loop all entities in radius 8 of player:
                    if loop-entity-2 is not player:
                        if loop-entity-2 is a monster:
                            # Random chance for clone to attack
                            chance of 30%:
                                damage loop-entity-2 by 3 hearts
                                play "CRIT" at loop-entity-2
                                play "CLOUD" at loop-entity-2
            
            # Consume mana
            subtract 60 from {player_mana_%player%}
            
            # Add XP
            add_skill_xp(player, 20)
            
            # Dispel effect
            play "EXPLOSION_LARGE" at player
            send "§6[Shadow Clone] §fClones desapareceram!" to player
            
            # Store last skill
            set {last_skill_%player%} to "shadowclone"
            set {last_skill_time_%player%} to now
            
        else:
            send "§c[AnimeSkills] Chakra insuficiente! Necessário: 60" to player
            play sound "ITEM_BREAK" to player

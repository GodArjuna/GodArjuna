# One For All - My Hero Academia
# Generated by AnimeSkills AI Generator
# Type: buff
# Description: Libera o poder acumulado, aumentando drasticamente suas habilidades

command /oneforall:
    permission: animeskills.my-hero-academia.one-for-all
    cooldown: 60 seconds
    cooldown message: §c[AnimeSkills] Aguarde %remaining time% para usar One For All novamente!
    trigger:
        # Check if player has enough mana
        if {player_mana_%player%} >= 80:
            # Activation message
            send "§a[One For All] §fPLUS..." to player
            play sound "ENDERDRAGON_GROWL" to player with pitch 2
            
            # Charging energy
            loop 20 times:
                play "FIREWORKS_SPARK" at player
                play "SPELL_INSTANT" at player
                play "ENCHANTMENT_TABLE" at player
                play sound "FIZZ" to player with pitch 2
                wait 2 ticks
            
            # Full power activation
            send "§a§l[One For All] §f§lULTRA!" to player
            play sound "EXPLODE" to all players in radius 30 of player
            play sound "ENDERDRAGON_GROWL" to all players in radius 30 of player
            
            # Visual aura
            loop 3 times:
                play "EXPLOSION_HUGE" at player
                wait 3 ticks
            
            # Power manifestation - green energy aura
            set {oneforall_%player%} to true
            
            # Enhanced stats
            apply strength 4 to player for 30 seconds
            apply speed 3 to player for 30 seconds
            apply resistance 3 to player for 30 seconds
            apply regeneration 3 to player for 30 seconds
            apply jump 3 to player for 30 seconds
            
            # Messages
            send "§a§l[One For All] §f§lACTIVADO!" to player
            send "§7Força IV, Velocidade III, Resistência III" to player
            send "§7Regeneração III, Salto III por 30 segundos!" to player
            broadcast "§a⚡ %player% §fativou §aOne For All§f!"
            
            # Periodic aura effects
            loop 30 times:
                if {oneforall_%player%} is true:
                    # Green lightning aura
                    play "FIREWORKS_SPARK" at player
                    play "VILLAGER_HAPPY" at player
                    play "ENCHANTMENT_TABLE" at player
                    
                    # Create circular aura
                    particle_circle(location of player, "VILLAGER_HAPPY", 1.5)
                    
                    # Enhanced melee damage
                    if {oneforall_hit_%player%} is set:
                        set {oneforall_hit_%player%} to false
                        send "§a§l⚡ DETROIT SMASH!" to player
                        
                        # Extra explosion effect
                        play "EXPLOSION_HUGE" at player
                    
                    wait 1 second
                else:
                    stop loop
            
            # Deactivation
            set {oneforall_%player%} to false
            send "§7[One For All] §fEfeito terminado. Você está exausto..." to player
            play sound "FIZZ" to player with pitch 0.5
            
            # Exhaustion debuff
            apply slowness 2 to player for 5 seconds
            apply weakness 1 to player for 5 seconds
            apply mining_fatigue 1 to player for 5 seconds
            
            # Consume mana
            subtract 80 from {player_mana_%player%}
            
            # Add XP
            add_skill_xp(player, 35)
            
            # Store last skill
            set {last_skill_%player%} to "oneforall"
            set {last_skill_time_%player%} to now
            
        else:
            send "§c[AnimeSkills] Energia insuficiente! Necessário: 80" to player
            play sound "ITEM_BREAK" to player

# Enhanced punch detection for One For All
on damage:
    if attacker is a player:
        if {oneforall_%attacker%} is true:
            # Bonus damage
            increase damage by 10
            
            # Visual feedback
            play "EXPLOSION_LARGE" at victim
            play "CRIT_MAGIC" at victim
            play sound "EXPLODE" to all players in radius 10 of victim
            
            # Extra knockback
            push victim in direction from attacker to victim with force 2
            push victim upwards with force 1
            
            # Set hit flag for message
            set {oneforall_hit_%attacker%} to true

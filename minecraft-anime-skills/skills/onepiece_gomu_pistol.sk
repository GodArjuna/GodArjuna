# Gomu Gomu no Pistol - One Piece
# Generated by AnimeSkills AI Generator
# Type: attack
# Description: Soco elástico de longo alcance

command /gomupistol:
    permission: animeskills.one-piece.gomu-pistol
    cooldown: 5 seconds
    cooldown message: §c[AnimeSkills] Aguarde %remaining time% para usar Gomu Gomu novamente!
    trigger:
        # Check if player has enough mana
        if {player_mana_%player%} >= 25:
            # Wind up
            send "§c[Gomu Gomu] §fGomu Gomu no..." to player
            play sound "STEP_WOOL" to player with pitch 0.5
            
            # Stretching effect
            loop 10 times:
                play "CLOUD" at player
                wait 1 tick
            
            # Punch!
            send "§c§l[Gomu Gomu] §f§lPISTOL!" to player
            play sound "ZOMBIE_REMEDY" to all players in radius 15 of player
            
            # Find target
            set {_target} to target entity of player within 15 blocks
            
            if {_target} is set:
                # Direct hit with stretch effect
                set {_start} to location of player
                set {_end} to location of {_target}
                
                # Stretching arm particle trail
                particle_line({_start}, {_end}, "CLOUD")
                
                # Impact
                damage {_target} by 8 hearts
                
                # Strong knockback
                push {_target} in direction from player to {_target} with force 3
                push {_target} upwards with force 0.5
                
                # Impact particles
                play "EXPLOSION_LARGE" at {_target}
                play "CRIT" at {_target}
                loop 10 times:
                    play "CRIT" at {_target}
                
                # Sound
                play sound "SUCCESSFUL_HIT" to all players in radius 10 of {_target}
                play sound "ZOMBIE_REMEDY" to {_target}
                
                send "§a[Gomu Gomu] §fAcerto direto!" to player
                
                # Check combo for Gatling
                if check_combo(player, "gomupistol"):
                    send "§6§l[Gomu Gomu] §f§lGATLING MODE!" to player
                    
                    # Rapid fire punches
                    loop 5 times:
                        wait 3 ticks
                        damage {_target} by 3 hearts
                        play "CRIT" at {_target}
                        play sound "SUCCESSFUL_HIT" to player
                        push {_target} backwards with force 0.5
                    
                    send "§6§l[Gomu Gomu] §f§lGATLING!" to player
            else:
                # Punch air - shorter range AOE
                set {_punch_loc} to location 3 meters in front of player
                
                # Wind pressure effect
                loop all entities in radius 3 of {_punch_loc}:
                    if loop-entity is not player:
                        damage loop-entity by 5 hearts
                        push loop-entity in direction from player to loop-entity with force 2
                        play "CLOUD" at loop-entity
                
                play "EXPLOSION_LARGE" at {_punch_loc}
                send "§c[Gomu Gomu] §fErrou o alvo!" to player
            
            # Consume mana
            subtract 25 from {player_mana_%player%}
            
            # Add XP
            add_skill_xp(player, 8)
            
            # Store last skill
            set {last_skill_%player%} to "gomupistol"
            set {last_skill_time_%player%} to now
            
        else:
            send "§c[AnimeSkills] Energia insuficiente! Necessário: 25" to player
            play sound "ITEM_BREAK" to player

# Kamehameha - Dragon Ball
# Generated by AnimeSkills AI Generator
# Type: attack
# Description: Poderosa onda de energia

command /kamehameha:
    permission: animeskills.dragon-ball.kamehameha
    cooldown: 15 seconds
    cooldown message: §c[AnimeSkills] Aguarde %remaining time% para usar Kamehameha novamente!
    trigger:
        # Check if player has enough mana
        if {player_mana_%player%} >= 70:
            # Charging phase
            send "§b[Kamehameha] §fKa... Me..." to player
            play sound "FIZZ" to player with pitch 0.5
            
            # Charging particles
            loop 30 times:
                play "SPELL_WITCH" at player
                play "FIREWORKS_SPARK" at player
                play "ENCHANTMENT_TABLE" at player
                wait 2 ticks
            
            send "§b[Kamehameha] §fHa... Me..." to player
            play sound "ENDERDRAGON_GROWL" to player with pitch 2
            
            loop 30 times:
                play "FIREWORKS_SPARK" at player
                play "CRIT_MAGIC" at player
                wait 2 ticks
            
            # Release
            send "§e§l[Kamehameha] §f§lHAAAAAAAA!" to player
            play sound "EXPLODE" to all players in radius 30 of player
            play sound "ENDERDRAGON_GROWL" to all players in radius 30 of player
            
            # Create beam effect
            set {_start} to location of player's eyes
            set {_direction} to direction of player
            
            # Beam damage
            loop 20 times:
                # Calculate beam position
                set {_distance} to loop-number
                set {_beam_loc} to {_start}
                
                # Move location forward
                loop {_distance} times:
                    set {_beam_loc} to location 1 meter in front of {_beam_loc}
                
                # Particle beam
                play "FIREWORKS_SPARK" at {_beam_loc}
                play "FLAME" at {_beam_loc}
                play "EXPLOSION_LARGE" at {_beam_loc}
                play "SPELL_INSTANT" at {_beam_loc}
                
                # Damage entities in beam path
                loop all entities in radius 2 of {_beam_loc}:
                    if loop-entity-2 is not player:
                        damage loop-entity-2 by 4 hearts
                        push loop-entity-2 in {_direction} with force 1
                        play "EXPLOSION_LARGE" at loop-entity-2
                
                # Block destruction effect (visual)
                play "LAVA_POP" at {_beam_loc}
                
                wait 1 tick
            
            # Final explosion at end
            set {_end_loc} to {_start}
            loop 20 times:
                set {_end_loc} to location 1 meter in front of {_end_loc}
            
            play "EXPLOSION_HUGE" at {_end_loc}
            play sound "EXPLODE" to all players in radius 30 of {_end_loc}
            
            # Damage entities at endpoint
            loop all entities in radius 5 of {_end_loc}:
                if loop-entity is not player:
                    damage loop-entity by 15 hearts
                    push loop-entity upwards with force 2
            
            # Consume mana
            subtract 70 from {player_mana_%player%}
            
            # Add XP
            add_skill_xp(player, 25)
            
            # Apply recoil/exhaustion
            apply slowness 2 to player for 3 seconds
            send "§7Você está exausto após o Kamehameha..." to player
            
            # Store last skill
            set {last_skill_%player%} to "kamehameha"
            set {last_skill_time_%player%} to now
            
        else:
            send "§c[AnimeSkills] Energia insuficiente! Necessário: 70" to player
            play sound "ITEM_BREAK" to player

# Rasengan - Naruto
# Generated by AnimeSkills AI Generator
# Type: attack
# Description: Esfera de chakra rotativo concentrado

command /rasengan:
    permission: animeskills.naruto.rasengan
    cooldown: 8 seconds
    cooldown message: §c[AnimeSkills] Aguarde %remaining time% para usar Rasengan novamente!
    trigger:
        # Check if player has enough mana
        if {player_mana_%player%} >= 40:
            # Visual charging effect
            send "§b[Rasengan] §fConcentrando chakra..." to player
            play "SPELL_INSTANT" at player
            play sound "FIZZ" to player
            
            wait 1 second
            
            # Execute skill effect
            set {_target} to target entity of player within 10 blocks
            if {_target} is set:
                # Direct hit
                send "§a[Rasengan] §fRASENGAN!" to player
                
                # Damage and effects
                damage {_target} by 12 hearts
                
                # Particle spiral effect
                loop 20 times:
                    play "SPELL_WITCH" at {_target}
                    play "CRIT_MAGIC" at {_target}
                    wait 1 tick
                
                # Knockback with rotation
                push {_target} upwards with force 0.8
                push {_target} in direction of player with force 2.5
                
                # Sound effects
                play sound "EXPLODE" to all players in radius 20 of {_target}
                play sound "ENDERDRAGON_GROWL" to {_target}
                
                # Check combo
                check_combo(player, "rasengan")
            else:
                # Area attack if no target
                send "§a[Rasengan] §fÁrea de explosão!" to player
                
                loop all entities in radius 4 of player:
                    if loop-entity is not player:
                        damage loop-entity by 8 hearts
                        push loop-entity in direction from player to loop-entity with force 2
                        play "EXPLOSION_LARGE" at loop-entity
            
            # Consume mana
            subtract 40 from {player_mana_%player%}
            
            # Add XP
            add_skill_xp(player, 10)
            
            # Store last skill for combo
            set {last_skill_%player%} to "rasengan"
            set {last_skill_time_%player%} to now
            
        else:
            send "§c[AnimeSkills] Chakra insuficiente! Necessário: 40" to player
            play sound "ITEM_BREAK" to player

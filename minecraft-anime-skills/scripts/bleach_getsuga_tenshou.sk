# Getsuga Tenshou - BLEACH
# Generated by AnimeSkills AI Generator
# Type: attack
# Date: 2025-12-22 10:49:24

command /getsuga-tenshou:
    permission: animeskills.bleach.getsuga-tenshou
    cooldown: 10 seconds
    cooldown message: §c[AnimeSkills] Aguarde %remaining time% para usar Getsuga Tenshou novamente!
    trigger:
        # Check if player has enough mana
        if {player_mana_%player%} >= 50:
            # Execute skill effect
            # Attack Effect
            set {{_target}} to target entity of player
            if {{_target}} is set:
                # Damage calculation
                damage {{_target}} by 10 hearts
                
                # Particle effects
                play "EXPLOSION_LARGE" at {{_target}}
                play sound "EXPLODE" to all players in radius 20 of {{_target}}
                
                # Knockback
                push {{_target}} upwards with force 1
                push {{_target}} in direction of player with force 2
            else:
                # Area attack
                loop all entities in radius 5 of player:
                    if loop-entity is not player:
                        damage loop-entity by 7 hearts
                        play "FLAME" at loop-entity
            
            # Consume mana
            subtract 50 from {player_mana_%player%}
            
            # Send messages
            send "§a[AnimeSkills] §fGetsuga Tenshou §aativado!" to player
            play sound "LEVEL_UP" to player
        else:
            send "§c[AnimeSkills] Mana insuficiente! Necessário: 50" to player

# Skill-specific functions
function getsuga-tenshou_effect(player: player):
    # Custom logic for Getsuga Tenshou
    # Add special conditions or effects here
    if player is sneaking:
        # Enhanced version
        multiply damage by 1.5
    
    # Combo system detection
    if {last_skill_%player%} is set:
        if difference between now and {last_skill_time_%player%} is less than 5 seconds:
            # Combo bonus
            send "§e[AnimeSkills] COMBO! +50% damage!" to player
            multiply damage by 1.5
    
    set {last_skill_%player%} to "Getsuga Tenshou"
    set {last_skill_time_%player%} to now

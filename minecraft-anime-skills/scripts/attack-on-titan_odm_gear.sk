# ODM Gear - ATTACK-ON-TITAN
# Generated by AnimeSkills AI Generator
# Type: movement
# Date: 2025-12-22 10:49:24

command /odm-gear:
    permission: animeskills.attack-on-titan.odm-gear
    cooldown: 10 seconds
    cooldown message: §c[AnimeSkills] Aguarde %remaining time% para usar ODM Gear novamente!
    trigger:
        # Check if player has enough mana
        if {player_mana_%player%} >= 50:
            # Execute skill effect
            # Movement Effect
            # Enhanced movement
            set velocity of player to direction of player
            multiply velocity of player by 3
            
            # Trail effect
            play "CLOUD" at player
            play sound "BAT_TAKEOFF" to player
            
            # Speed boost
            apply speed 3 to player for 3 seconds
            
            # Consume mana
            subtract 50 from {player_mana_%player%}
            
            # Send messages
            send "§a[AnimeSkills] §fODM Gear §aativado!" to player
            play sound "LEVEL_UP" to player
        else:
            send "§c[AnimeSkills] Mana insuficiente! Necessário: 50" to player

# Skill-specific functions
function odm-gear_effect(player: player):
    # Custom logic for ODM Gear
    # Add special conditions or effects here
    if player is sneaking:
        # Enhanced version
        multiply damage by 1.5
    
    # Combo system detection
    if {last_skill_%player%} is set:
        if difference between now and {last_skill_time_%player%} is less than 5 seconds:
            # Combo bonus
            send "§e[AnimeSkills] COMBO! +50% damage!" to player
            multiply damage by 1.5
    
    set {last_skill_%player%} to "ODM Gear"
    set {last_skill_time_%player%} to now

# Shadow Clone - NARUTO
# Generated by AnimeSkills AI Generator
# Type: buff
# Date: 2025-12-22 10:46:22

command /shadow-clone:
    permission: animeskills.naruto.shadow-clone
    cooldown: 10 seconds
    cooldown message: §c[AnimeSkills] Aguarde %remaining time% para usar Shadow Clone novamente!
    trigger:
        # Check if player has enough mana
        if {player_mana_%player%} >= 50:
            # Execute skill effect
            # Buff Effect
            # Apply multiple buffs
            apply strength 2 to player for 30 seconds
            apply speed 2 to player for 30 seconds
            apply regeneration 1 to player for 30 seconds
            
            # Visual aura
            play "ENCHANTMENT_TABLE" at player
            play sound "LEVEL_UP" to player
            
            # Broadcast
            broadcast "§6[AnimeSkills] §f%player% §6ativou um poder especial!" 
            
            # Consume mana
            subtract 50 from {player_mana_%player%}
            
            # Send messages
            send "§a[AnimeSkills] §fShadow Clone §aativado!" to player
            play sound "LEVEL_UP" to player
        else:
            send "§c[AnimeSkills] Mana insuficiente! Necessário: 50" to player

# Skill-specific functions
function shadow-clone_effect(player: player):
    # Custom logic for Shadow Clone
    # Add special conditions or effects here
    if player is sneaking:
        # Enhanced version
        multiply damage by 1.5
    
    # Combo system detection
    if {last_skill_%player%} is set:
        if difference between now and {last_skill_time_%player%} is less than 5 seconds:
            # Combo bonus
            send "§e[AnimeSkills] COMBO! +50% damage!" to player
            multiply damage by 1.5
    
    set {last_skill_%player%} to "Shadow Clone"
    set {last_skill_time_%player%} to now
